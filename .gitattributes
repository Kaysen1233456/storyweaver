# Normalize line endings to LF in the repository
* text=auto eol=lf

# Explicit binary files (never convert)
*.pth binary
*.pt binary
*.bin binary
*.npz binary
*.png binary
*.jpg binary
*.mp4 binary

# Shell / PowerShell scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Python and Markdown
*.py text eol=lf
*.md text eol=lf
